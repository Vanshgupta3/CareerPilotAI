generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  interviews Interview[]
  resumes    Resume[]
}

model Resume {
  id         String          @id @default(cuid())
  title      String
  fileUrl    String
  uploadedAt DateTime        @default(now())
  userId     String
  content    String?
  interviews Interview[]
  user       User            @relation(fields: [userId], references: [id])
  analysis   ResumeAnalysis?
}

model Interview {
  id                String             @id @default(cuid())
  role              String
  level             String
  createdAt         DateTime           @default(now())
  userId            String
  resumeId          String
  type              String
  currentDifficulty String?
  currentTopic      String?
  endedAt           DateTime?
  mode              String             @default("NORMAL")
  startedAt         DateTime?
  status            String             @default("CREATED")
  feedback          Feedback?
  resume            Resume             @relation(fields: [resumeId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  messages          InterviewMessage[]
  questions         Question[]
  reviews           QuestionReview[]
}

model Question {
  id           String    @id @default(cuid())
  questionText String
  interviewId  String
  answers      Answer[]
  interview    Interview @relation(fields: [interviewId], references: [id])
}

model Answer {
  id         String   @id @default(cuid())
  answerText String
  score      Float?
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model InterviewMessage {
  id          String          @id @default(cuid())
  role        String
  content     String
  messageType String          @default("MESSAGE")
  topic       String?
  difficulty  String?
  createdAt   DateTime        @default(now())
  interviewId String
  interview   Interview       @relation(fields: [interviewId], references: [id])
  reviews     QuestionReview?
}

model Feedback {
  id                  String    @id @default(cuid())
  overallScore        Float
  strengths           String
  weaknesses          String
  suggestions         String
  interviewId         String    @unique
  communicationScore  Float
  confidenceScore     Float
  problemSolvingScore Float
  summary             String
  technicalScore      Float
  interview           Interview @relation(fields: [interviewId], references: [id])
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  atsScore        Float
  summary         String
  strengths       String
  weaknesses      String
  suggestions     String
  createdAt       DateTime @default(now())
  resumeId        String   @unique
  formatScore     Float?
  grammarScore    Float?
  missingKeywords Json
  skills          Json
  resume          Resume   @relation(fields: [resumeId], references: [id])
}

model QuestionReview {
  id                String           @id @default(cuid())
  interviewId       String
  questionMessageId String           @unique
  candidateAnswer   String
  idealAnswer       String
  explanation       String
  score             Float
  createdAt         DateTime         @default(now())
  interview         Interview        @relation(fields: [interviewId], references: [id])
  questionMessage   InterviewMessage @relation(fields: [questionMessageId], references: [id])
}
